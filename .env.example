# --- Live news providers (all fetched server-side; keys never reach the client) ---

# Optional. NewsAPI.org key for the /v2/everything supplement.
# The site works without it: GDELT and ReliefWeb are keyless fallbacks.
NEWS_API_KEY=

# ReliefWeb requires an application name registered with their API programme.
# A descriptive default is used if unset; register your own for production.
RELIEFWEB_APP_NAME=

# Seconds to cache each provider response server-side (stale-while-revalidate).
NEWS_CACHE_TTL_SECONDS=1800

# How many hops in front of this server append to x-forwarded-for. The
# /api/news rate limiter counts this many entries in from the right of that
# header to find the reader's own address, so setting it wrong either shares
# one bucket between everybody behind an edge (false 429s) or lets a reader
# choose their own bucket.
#
#   1  (default)  a platform edge (Vercel, Netlify) or a single reverse proxy
#                 that appends, e.g. nginx with proxy_add_x_forwarded_for.
#                 Also the least wrong setting for `next start` served
#                 directly, where the limit is best-effort: Next fills the
#                 header from the socket only when the reader sends none.
#   2             a CDN in front of a proxy, where both append.
#   3+            one per additional appending hop.
#
# Values below 1 are treated as 1. If your platform publishes a single-value
# client-address header instead (CF-Connecting-IP and the like), that header
# is the more reliable key and wants a small code change in
# src/lib/news/cache.ts rather than a hop count.
RATE_LIMIT_TRUSTED_HOPS=1

# --- Open-web sweep (scripts/news-ingest.mjs; never used by the site) ---

# Optional. Lets the sweep's writing step draft reported-layer rows with a
# Claude model. In GitHub, set it as a repository secret of the same name
# rather than here. Without it the sweep still runs and queues its leads
# in scripts/watch/news-review.json for a human read. Strictly a build/CI
# credential: no route or page ever reads it.
ANTHROPIC_API_KEY=

# --- Map ---

# Optional MapLibre style URL (e.g. a MapTiler/Protomaps style with your key).
# If unset, the map renders governorate boundaries over a plain background,
# which requires no external tile service.
NEXT_PUBLIC_MAP_STYLE_URL=

# --- Site ---

# Canonical site URL used for metadata, sitemap and share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Reserved for a future PostgreSQL/Supabase migration of the
# analytical dataset (see docs/data-import.md); the site currently ships
# with validated JSON and does not require a database.
DATABASE_URL=
